# Portable deployment template
# Copy to .env.local and replace every placeholder before starting the service.
# Do not use this file directly as a runtime or test environment.

# Required: PostgreSQL connection string for Prisma 7 via prisma.config.ts / @prisma/adapter-pg
DATABASE_URL="REPLACE_WITH_DATABASE_URL"

# Optional per-process PostgreSQL pool limits. The smaller size/cap is used.
# Legacy DATABASE_URL pool_max / connection_limit / pool_idle_timeout override these.
DB_POOL_SIZE="10"
DB_CONNECTION_LIMIT="10"
DB_POOL_IDLE_TIMEOUT_MS="30000"

# Required: random secret, at least 32 bytes. Example: openssl rand -base64 48
AUTH_SESSION_SECRET="REPLACE_WITH_RANDOM_SESSION_SECRET_AT_LEAST_32_BYTES"

# Required: 32-byte encryption key for stored server/storage/API credentials.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="REPLACE_WITH_64_HEX_CHARACTER_ENCRYPTION_KEY"

# Required for first seed/bootstrap only. Use a strong one-time password, then change it in app.
ADMIN_INITIAL_PASSWORD="REPLACE_WITH_STRONG_ONE_TIME_ADMIN_PASSWORD"

# Public display label on login page. Use your domain or site name.
APP_NAME="vcontrolhub"
APP_SLUG="vcontrolhub"
SITE_NAME="VPS 统一管控平台"
AUTH_SESSION_COOKIE_NAME="***"
AUTH_SESSION_ISSUER="your-app-slug"
AUTH_SESSION_AUDIENCE="your-app-slug-console"
NEXT_PUBLIC_APP_PUBLIC_LABEL="your-domain.example"
NEXT_PUBLIC_APP_DESCRIPTION="统一 VPS 管理、审批执行、分布式云盘与媒体浏览平台"

# Next.js binding for systemd/start scripts
HOSTNAME="127.0.0.1"
PORT="3000"
# Required for Agent mode. Agents connect outbound to this HTTPS URL.
APP_BASE_URL="https://your-domain.example"

# SSH WebSocket proxy binding. Caddy/Nginx should proxy /ssh to this port.
SSH_WS_HOST="127.0.0.1"
SSH_WS_PORT="3001"
# Optional comma-separated browser origins allowed by the SSH WS proxy, e.g. https://your-domain.example
SSH_WS_ALLOWED_ORIGINS="https://your-domain.example"
# Required in production: shared secret between WS proxy and browser clients.
# Example: openssl rand -hex 32
SSH_WS_SECRET="REPLACE_WITH_RANDOM_SSH_WS_SECRET"
SSH_POOL_IDLE_TIMEOUT_MS="600000"
SSH_FAILURE_BACKOFF_MS="30000"
# Do not expose the SSH websocket secret through NEXT_PUBLIC_* variables.
# Browser terminal sessions use short-lived /api/auth/ws-token tokens instead.

# Windows remote desktop gateway (see docs/windows-remote-desktop.md).
# RDP_ENABLED=true plus a loopback guacd are required for /rdp to accept sessions.
#RDP_ENABLED="true"
#GUACD_PORT="4822"
# Session policy shares the runtime settings surface with SSH (settings page →
# runtime). 0 disables a limit: sessions live as long as their browser does.
#RDP_IDLE_TIMEOUT_SEC="0"
#RDP_MAX_SESSION_SEC="0"
# Text clipboard sync between browser and remote desktop (default on).
#RDP_ENABLE_CLIPBOARD="true"
# Remote audio playback (default off; requires guacd with FreeRDP audio).
#RDP_AUDIO_ENABLED="false"

# Local storage defaults used by storage nodes / uploads. Create these directories on each VPS.
STORAGE_ROOT="/var/lib/${APP_SLUG:-vcontrolhub}/storage"
DOWNLOAD_ROOT="/var/lib/${APP_SLUG:-vcontrolhub}/downloads"
BACKUP_DIR="/var/backups/${APP_SLUG:-vcontrolhub}"

# Audit log retention (days). audit_logs grows with every login/command/file
# operation; rows older than this are pruned by the job maintenance worker.
# 0 disables pruning (compliance setups that archive externally instead).
#AUDIT_RETENTION_DAYS="365"
# Per-sweep delete cap — keeps the first pruning pass after enabling
# retention on a mature instance from monopolising the database.
#AUDIT_PRUNE_BATCH_SIZE="5000"

# aria2 is required for magnet/BT relay downloads. install.sh auto-generates
# ARIA2_RPC_SECRET if it is missing or left as a placeholder.
ARIA2_RPC_HOST="127.0.0.1"
ARIA2_RPC_PORT="6800"
ARIA2_RPC_SECRET="REPLACE_WITH_RANDOM_ARIA2_RPC_SECRET"
ARIA2_RPC_DIR="/var/lib/${APP_SLUG:-vcontrolhub}/aria2"

# Optional integrations. Leave empty if not installed on the target VPS.
ALIST_INTERNAL_URL="http://127.0.0.1:5244"
EMBY_INTERNAL_URL="http://127.0.0.1:8096"

# Production safety: demo fallback is OFF by default. Only set true for local demo without DB.
# PostgreSQL auto-setup (used by install.sh on fresh hosts)
PG_AUTO_SETUP="1"
PG_DB_NAME="vcontrolhub"
PG_DB_USER="vcontrolhub"
PG_DB_PASSWORD=""

ENABLE_DEMO_FALLBACK="false"
AUTH_DEMO_FALLBACK="false"
SERVER_DEMO_FALLBACK="false"
STORAGE_DEMO_FALLBACK="false"
COMMAND_DEMO_FALLBACK="false"
SEED_DEMO_DATA="false"
