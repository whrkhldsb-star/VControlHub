node_modules
.next
.git
storage
tmp
uploads
downloads
backups
logs
dist
*.pem
*.key
*.ppk
# Live secrets must never enter the build context (docker build COPY . . would
# bake them into builder-stage layers, recoverable via docker history/save).
# .env.example stays committable and is negated below.
.env
.env.*
!.env.example
_test_*.js
_test_*.ts
check_*.py
make_*.py
*.tsbuildinfo

# Local audit/rollback trees are never runtime image inputs.
dist.*
.next.*
node_modules.*
.audit-*
coverage
playwright-report
test-results

# Local databases, dumps and test outputs must stay outside builder layers.
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.dump
**/*.sql
!prisma/migrations/**/migration.sql
**/*.sql.gz
**/.playwright-output
**/.local
**/.npm
**/file-versions
