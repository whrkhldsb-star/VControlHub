[Unit]
Description={{SITE_NAME}} daily recovery backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User={{APP_USER}}
Group={{APP_USER}}
WorkingDirectory={{APP_DIR}}
EnvironmentFile={{RUNTIME_ENV_FILE}}
Environment=ENV_FILE={{RUNTIME_ENV_FILE}}
# BACKUP_DIR, retention and the offsite switch come from the environment file
# (A10-02): fixed values here hid the nightly backups from the application's
# own listing, retention and offsite upload.
Environment=BACKUP_INCLUDE_ENV=true
ExecStart={{NODE_BIN}} {{APP_DIR}}/scripts/backup.mjs --full
ExecStartPost={{NODE_BIN}} {{APP_DIR}}/dist/upload-recovery-backup.js
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
ReadWritePaths={{BACKUP_DIR}}
MemoryMax=512M
TimeoutStartSec=30min
