# Managed by VControlHub installer: {{APP_SLUG}}
{
	auto_https disable_redirects
}

(vcontrolhub_routes) {
	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		# Do not set X-Frame-Options here. The app emits SAMEORIGIN plus CSP
		# frame-src/media-src rules so authenticated PDF/media previews can render.
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
	}

	# Disable caching for Next.js page routes (paths without file extensions)
	# Prevents Cloudflare from caching stale HTML that references expired CSS/JS hashes
	# Static files like sw.js, *.png, *.svg are unaffected and keep normal caching
	@html {
		path_regexp ^/[^.]*$
		not path /api/*
		not path /direct/*
	}
	header @html Cache-Control "no-cache, no-store, must-revalidate"

	reverse_proxy /ssh 127.0.0.1:3001
	reverse_proxy /ssh/* 127.0.0.1:3001

	# Optional AList
	reverse_proxy /files-proxy 127.0.0.1:5244
	reverse_proxy /files-proxy/* 127.0.0.1:5244

	# Optional Emby
	reverse_proxy /emby 127.0.0.1:8096
	reverse_proxy /emby/* 127.0.0.1:8096
	reverse_proxy /web/* 127.0.0.1:8096
	reverse_proxy /Startup/* 127.0.0.1:8096

	reverse_proxy 127.0.0.1:3000
}

http://your-domain.example {
	# Flexible SSL reaches the origin over HTTP even for HTTPS visitors.
	# Cloudflare forwards the visitor's scheme in X-Forwarded-Proto.
	@plain not header X-Forwarded-Proto https
	redir @plain https://your-domain.example{uri} 308
	import vcontrolhub_routes
}

https://your-domain.example {
	import vcontrolhub_routes
}
